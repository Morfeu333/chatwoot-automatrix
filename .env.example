# =============================================
# Chatwoot — Automatrix Production Config
# Copy to .env and fill in your values
# =============================================

SECRET_KEY_BASE=generate_with_rails_secret

# Public URL (must match your Cloudflare Tunnel subdomain)
FRONTEND_URL=https://chatwoot.yourdomain.com
FORCE_SSL=false  # Cloudflare handles TLS; tunnel sends HTTP internally

# Database
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=change_me

# Redis
REDIS_URL=redis://:change_me@redis:6379
REDIS_PASSWORD=change_me

# Rails
RAILS_ENV=production

# SMTP — Gmail App Password
MAILER_SENDER_EMAIL=you@gmail.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Registration
ENABLE_ACCOUNT_SIGNUP=false

# =============================================
# WhatsApp Cloud API (Meta)
# App: wepwep (separate app from Instagram)
# =============================================
# Configured via Chatwoot Super Admin > Settings > WhatsApp
# or via Chatwoot inbox creation UI

# Optional: Chatwoot's native WhatsApp Embedded Signup. Configure the Meta
# app for Facebook Login for Business and Embedded Signup before enabling.
# Keep the real app secret out of Git. The Graph API version must be supported
# by the exact Chatwoot image deployed.
# WHATSAPP_APP_ID=your_whatsapp_meta_app_id
# WHATSAPP_APP_SECRET=your_whatsapp_meta_app_secret
# WHATSAPP_CONFIGURATION_ID=your_embedded_signup_configuration_id
# WHATSAPP_API_VERSION=vXX.X

# =============================================
# Facebook + Instagram (Meta)
# App: autocem — App ID: 1170128801145266
# Instagram Business Login Client ID: 1331322001413996
# =============================================
FACEBOOK_APP_ID=1170128801145266
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_VERIFY_TOKEN=your_custom_verify_token

# These are set via Super Admin UI but can also be env vars:
# INSTAGRAM_APP_ID=1331322001413996
# INSTAGRAM_APP_SECRET=your_instagram_client_secret
# INSTAGRAM_VERIFY_TOKEN=your_custom_verify_token

# =============================================
# Custom patch: Instagram Comments → n8n
# Set to your n8n webhook URL to receive
# Instagram comment events (comments/live_comments)
# =============================================
INSTAGRAM_COMMENTS_N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/instagram-comments
